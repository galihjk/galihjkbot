APP_NAME=TelegramMultiBot
APP_ENV=development
APP_VERSION=0.1.0
TIMEZONE=Asia/Jakarta

TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERADMIN_IDS=
TELEGRAM_DROP_PENDING_UPDATES=false

# Channel tempat leaderboard bulanan diumumkan (ID numerik channel, biasanya
# negatif dan diawali -100). Kosongkan untuk menonaktifkan fitur leaderboard
# bulanan sepenuhnya (skor tidak akan pernah dihapus tanpa channel ini).
TELEGRAM_LEADERBOARD_CHANNEL_ID=
# Link/username channel di atas, dipakai di teks pengumuman ke grup. Opsional.
TELEGRAM_LEADERBOARD_CHANNEL_LINK=

# Kosongkan untuk pakai default: data/bot.db (path absolut, aman untuk dev/Termux)
DATABASE_URL=

LOG_LEVEL=INFO
